{
  "name": "nexo-copiloto",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --local",
    "db:bundle": "node scripts/bundle-migrations.mjs",
    "copiloto:eval": "tsx --env-file-if-exists=.env.local src/copiloto/eval/run-eval.ts",
    "copiloto:probe": "tsx --env-file-if-exists=.env.local src/copiloto/eval/probe.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.0",
    "@typesafe-ai/sdk": "0.6.0",
    "@vercel/oidc": "^3.8.9",
    "decimal.js": "10.6.0",
    "lucide-react": "1.47.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
