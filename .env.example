NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Asistente (Nexo Copiloto). En Vercel no hace falta ninguna clave: Jev va por AI Gateway con el
# token OIDC del despliegue. En local, `vercel link` + `vercel env pull` crean VERCEL_OIDC_TOKEN.
# Alternativas: TYPESAFE_API_KEY (TypeSafe directo) o AI_GATEWAY_API_KEY (clave vck_ del gateway).
# TYPESAFE_API_KEY=
# AI_GATEWAY_API_KEY=
# Redacción con LLM (opcional; por defecto plantillas): WRITER_PROVIDER=openai, WRITER_URL=https://ai-gateway.vercel.sh, WRITER_MODEL=<modelo>
